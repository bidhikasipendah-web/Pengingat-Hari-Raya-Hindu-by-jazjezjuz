<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100C16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕉️  Pengingat Hari Raya Hindu Bali"
            android:textColor="#D7A6FF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kalender &amp; Pengingat Hari Suci"
            android:textColor="#C8B8D8"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingBottom="18dp" />

        <!-- TANGGAL HARI INI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#24182D"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 HARI INI"
                android:textColor="#D7A6FF"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:paddingTop="6dp" />

        </LinearLayout>

        <!-- HARI RAYA TERDEKAT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#32203D"
            android:padding="18dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌺 HARI SUCI UTAMA"
                android:textColor="#F1C7FF"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/events"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#EEEEEE"
                android:textSize="17sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- NOTIFIKASI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 PENGINGAT"
            android:textColor="#D7A6FF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🔔  AKTIFKAN NOTIFIKASI"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🔔  TES NOTIFIKASI"
            android:textSize="16sp"
            android:layout_marginTop="10dp" />

        <!-- MENU -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ FITUR APLIKASI"
            android:textColor="#D7A6FF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📅&#10;Kalender"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="#24182D" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="➕&#10;Pengingat"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="#24182D" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌺 Om Santih, Santih, Santih Om"
            android:textColor="#9E8AA8"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="28dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>
